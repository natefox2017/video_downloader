{
  "action": {
    "default_title": "视频下载助手"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "js": [
        "rules.js",
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_end"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/douyin.js"
      ],
      "matches": [
        "*://*.douyin.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/kuaishou.js"
      ],
      "matches": [
        "*://*.kuaishou.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/bilibili.js"
      ],
      "matches": [
        "*://*.bilibili.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/weibo.js"
      ],
      "matches": [
        "*://*.weibo.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/xiaohongshu.js"
      ],
      "matches": [
        "*://*.xiaohongshu.com/*",
        "*://*.xhslink.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/youtube.js"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://youtu.be/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/tiktok.js"
      ],
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/vimeo.js"
      ],
      "matches": [
        "*://*.vimeo.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/twitch.js"
      ],
      "matches": [
        "*://*.twitch.tv/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/instagram.js"
      ],
      "matches": [
        "*://*.instagram.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/facebook.js"
      ],
      "matches": [
        "*://*.facebook.com/*",
        "*://fb.watch/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    },
    {
      "js": [
        "extractors/common.js",
        "extractors/twitter.js"
      ],
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "description": "自动识别并下载网页中的视频：支持抖音、快手、哔哩哔哩、微博、小红书、YouTube、TikTok、Vimeo、Twitch、Instagram、Facebook、X 等主流平台，未覆盖的网站自动嗅探直链与 m3u8。批量下载、极简列表，开源免费。",
  "homepage_url": "https://github.com/natefox2017/video_downloader",
  "author": "natefox2017",
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "images/16.png",
    "32": "images/32.png",
    "48": "images/48.png",
    "128": "images/128.png"
  },
  "manifest_version": 3,
  "name": "视频下载助手",
  "permissions": [
    "scripting",
    "storage"
  ],
  "version": "2.3.0",
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "panel.html",
        "panel.js",
        "panel.css",
        "images/*",
        "images/logo.svg"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
