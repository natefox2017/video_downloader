{
   "manifest_version": 3,
   "name": "抖抖抖 抖音视频下载器 (批量下载)",
   "version": "2.2.0",
   "description": "什么垃圾东西 还好意思加密出来卖。",
   "action": {
      "default_title": "抖抖抖 抖音视频下载"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [
      {
         "js": [ "content.js" ],
         "matches": [ "*://*.douyin.com/*" ],
         "run_at": "document_end"
      }
   ],
   "permissions": [ "scripting" ],
   "host_permissions": [
      "https://*.douyin.com/*",
      "https://*.douyinvod.com/*",
      "https://*.douyinpic.com/*",
      "https://*.douyinstatic.com/*",
      "https://*.byteimg.com/*",
      "https://*.zjcdn.com/*",
      "https://*.ixigua.com/*",
      "https://*.pstatp.com/*"
   ],
   "icons": {
      "16": "images/16.png",
      "32": "images/32.png",
      "128": "images/128.png"
   },
   "web_accessible_resources": [
      {
         "matches": [ "*://*.douyin.com/*" ],
         "resources": [
            "injected.js",
            "panel.html",
            "panel.js",
            "panel.css",
            "images/*"
         ]
      }
   ]
}
