# ============================================================================
# .gitignore —— 本仓库不入库的内容
# 原则：只提交「源码 + 文档 + 图标资源」，其余一切本地产物都不进仓库。
# ============================================================================

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ---------- 工具运行产物 ----------
# 视频加工的默认输出目录（<视频目录>/out）与日志
out/
*.log

# 画中画素材池缓存：由 video_frame_tool.py 在素材目录内自动生成，
# 记录了素材时长与文件指纹，换机器会自动重建，无需提交。
.pip_cache.json

# 画中画素材的「加速副本」目录：由 video_frame_tool.py 在素材目录内自动生成，
# 体积可达数百 MB，且能随时按原素材重建，绝不入库。
.pip_small/

# ---------- 本地工作区数据 ----------
# .workbuddy/ 存的是本机的记忆文件、原始插件备份与临时验证脚本，
# 含本地绝对路径与个人工作记录，仅供本机使用，不入库。
.workbuddy/

# ---------- 压缩包 / 二进制大文件 ----------
*.tar.gz
*.zip
*.7z
*.mp4
*.mov
*.mkv

# ---------- 对比样本（原视频 / 软件产物 / 平台产物） ----------
# 用于逆向「平台查重算法」的样本目录，含用户提供的原视频与平台处理后的视频，
# 体积大且属个人素材，绝不入库。
video_frame_tool/视频对比/

# ---------- WorkBuddy 相关工具目录 ----------
# workbuddy-switch 是独立的 Rust 项目（自带 .git），不属于本仓库。
workbuddy-switch/
